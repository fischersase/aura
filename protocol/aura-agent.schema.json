{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fischersase/aura/protocol/aura-agent.schema.json",
  "title": "Aura Agent RPC, Protokollversion 1",
  "description": "JSON-RPC 2.0 über stdin/stdout zwischen Electron (src/agent2) und dem Agenten (agent/). Eine JSON-Zeile pro Nachricht. requests: Electron → Agent. hostRequests: Agent → Electron. notifications: Agent → Electron, ohne Antwort.",
  "$defs": {
    "requests": {
      "initialize": {
        "params": {
          "type": "object",
          "required": [
            "protocol"
          ],
          "properties": {
            "protocol": {
              "const": 1
            },
            "warmUp": {
              "type": "boolean"
            },
            "settings": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "ollamaUrl": {
                  "type": "string"
                },
                "numCtx": {
                  "type": "integer"
                },
                "keepAlive": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                },
                "sessionType": {
                  "type": "string"
                },
                "dataDir": {
                  "type": "string"
                },
                "auraDir": {
                  "type": "string"
                },
                "toolPolicy": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "ask",
                      "auto",
                      "off"
                    ]
                  }
                },
                "browserCommand": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "browserEnv": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "mcpServers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "command": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array"
                      },
                      "env": {
                        "type": "object"
                      },
                      "cwd": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "headers": {
                        "type": "object"
                      },
                      "autoApprove": {
                        "type": "array"
                      },
                      "error": {
                        "type": "string"
                      },
                      "auth": {
                        "enum": [
                          "oauth",
                          ""
                        ]
                      },
                      "catalogId": {
                        "type": "string",
                        "description": "Entry in the Aura connector catalog (AURA-96); its tiers apply."
                      },
                      "source": {
                        "type": "string",
                        "description": "\"registry\": installed from the public MCP registry, unreviewed (all tools ask)."
                      }
                    }
                  }
                },
                "disabledSkills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "provider": {
                  "enum": [
                    "ollama",
                    "gemini"
                  ]
                },
                "geminiModel": {
                  "type": "string"
                },
                "geminiApiKey": {
                  "type": "string",
                  "description": "Nur wenn provider = gemini; wird nie protokolliert."
                },
                "memoryPaused": {
                  "type": "boolean"
                },
                "connectors": {
                  "type": "array",
                  "description": "Curated connector catalog (src/catalog/connectors.json, AURA-96).",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title"
                    ]
                  }
                },
                "declinedConnectors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Connector IDs the user never wants suggested."
                },
                "locationMode": {
                  "enum": [
                    "profile",
                    "ip",
                    "device"
                  ],
                  "description": "Location source chosen by the user (AURA-116)."
                },
                "profilePlace": {
                  "type": "string",
                  "description": "Place from the user's profile, if shared."
                }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "protocol",
            "version",
            "model"
          ],
          "properties": {
            "protocol": {
              "const": 1
            },
            "version": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "enum": [
                "ollama",
                "gemini"
              ]
            }
          }
        }
      },
      "task.start": {
        "params": {
          "type": "object",
          "required": [
            "taskId",
            "chatId",
            "text"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "chatId": {
              "type": "string",
              "description": "Chat-ID; der Agent führt pro Chat eine ADK-Sitzung."
            },
            "text": {
              "type": "string"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "mime": {
                    "type": "string"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            },
            "incognito": {
              "type": "boolean",
              "description": "Incognito chat: no memory read or written, conversation not kept for recall (AURA-108)."
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "const": true
            }
          }
        }
      },
      "task.cancel": {
        "params": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "cancelled"
          ],
          "properties": {
            "cancelled": {
              "type": "boolean"
            }
          }
        }
      },
      "task.cancelAll": {
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object",
          "required": [
            "cancelled"
          ],
          "properties": {
            "cancelled": {
              "type": "integer"
            }
          }
        }
      },
      "catalog.list": {
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object",
          "required": [
            "tools"
          ],
          "properties": {
            "tools": {
              "type": "array"
            }
          }
        }
      },
      "ping": {
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object"
        }
      },
      "shutdown": {
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object"
        }
      },
      "policy.list": {
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object",
          "required": [
            "file",
            "rules"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "rules": {
              "type": "array"
            }
          }
        }
      },
      "chat.forget": {
        "description": "Deletes everything the agent stored about a chat (session and episodes); running tasks of the chat are cancelled first (NFR-PRIV-007).",
        "params": {
          "type": "object",
          "required": [
            "chatId"
          ],
          "properties": {
            "chatId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "sessions",
            "episodes"
          ],
          "properties": {
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "episodes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "chat.retain": {
        "description": "Forgets sessions of chats that are not in chatIds (orphans). Sessions of voice tasks (id 'voice-…') are kept.",
        "params": {
          "type": "object",
          "required": [
            "chatIds"
          ],
          "properties": {
            "chatIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "chats",
            "sessions",
            "episodes"
          ],
          "properties": {
            "chats": {
              "type": "integer",
              "minimum": 0
            },
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "episodes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "memory.list": {
        "description": "All facts with provenance, and whether memory is paused (AURA-108).",
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object",
          "required": [
            "facts",
            "paused"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "topic",
                  "source",
                  "created"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "explicit",
                      "learned",
                      "imported",
                      "edited"
                    ]
                  },
                  "chat_id": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  },
                  "created": {
                    "type": "number"
                  },
                  "last_used": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "confidence": {
                    "type": "number"
                  }
                }
              }
            },
            "paused": {
              "type": "boolean"
            }
          }
        }
      },
      "memory.update": {
        "description": "The user corrected a fact; its source becomes 'edited'.",
        "params": {
          "type": "object",
          "required": [
            "id",
            "text"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            }
          }
        }
      },
      "memory.delete": {
        "description": "Deletes one fact.",
        "params": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "removed"
          ],
          "properties": {
            "removed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "memory.deleteAll": {
        "description": "Deletes all facts.",
        "params": {
          "type": "object"
        },
        "result": {
          "type": "object",
          "required": [
            "removed"
          ],
          "properties": {
            "removed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "hostRequests": {
      "host.approve": {
        "params": {
          "type": "object",
          "required": [
            "taskId",
            "stepId",
            "tool",
            "label",
            "tier"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "stepId": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "tier": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2,
              "description": "Nur T2 wird gefragt; T0/T1 laufen, T3 ist gesperrt."
            },
            "reason": {
              "type": "string"
            },
            "effect": {
              "type": "string",
              "description": "Genaue Wirkung (Befehl, Pfad, Diff)."
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "enum": [
                "once",
                "task",
                "always",
                "deny"
              ],
              "description": "task = Rest dieses Auftrags ohne Rückfrage; always = Regel in ~/.aura/policy.toml anlegen."
            }
          }
        }
      },
      "host.screenshot": {
        "params": {
          "type": "object",
          "properties": {
            "maxWidth": {
              "type": "integer"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "mime",
            "data"
          ],
          "properties": {
            "mime": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            }
          }
        }
      },
      "host.ask": {
        "params": {
          "type": "object",
          "required": [
            "taskId",
            "question",
            "options"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 5
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "description": "Leer = keine Antwort (Abbruch oder Zeitüberschreitung)."
            }
          }
        }
      },
      "host.input": {
        "params": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "click",
                "type",
                "keys"
              ]
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "button": {
              "enum": [
                "left",
                "right"
              ]
            },
            "double": {
              "type": "boolean"
            },
            "text": {
              "type": "string"
            },
            "keys": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "via": {
              "type": "string"
            }
          }
        }
      },
      "host.authHeader": {
        "description": "Authorization header for one request to an OAuth MCP server (AURA-95). The app refreshes tokens; the agent never holds a refresh token.",
        "params": {
          "type": "object",
          "required": [
            "server"
          ],
          "properties": {
            "server": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "Authorization": {
              "type": "string",
              "pattern": "^Bearer "
            },
            "error": {
              "type": "string"
            }
          }
        }
      },
      "host.searchRegistry": {
        "description": "Search the official MCP registry (AURA-96). The app makes the HTTP request; the agent needs no network access.",
        "params": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "publisher": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "error": {
              "type": "string"
            }
          }
        }
      },
      "host.proposeConnector": {
        "description": "Connect card in the panel (AURA-96). Nothing is installed; on connect the app opens the Zentrale with the entry pre-filled.",
        "params": {
          "type": "object",
          "required": [
            "taskId",
            "id",
            "title",
            "verified",
            "risk",
            "reason"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "publisher": {
              "type": "string"
            },
            "verified": {
              "enum": [
                "aura",
                "registry"
              ]
            },
            "description": {
              "type": "string"
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "enum": [
                "connect",
                "later",
                "never"
              ]
            }
          }
        }
      },
      "host.takeover": {
        "description": "The user takes over the browser for a login, CAPTCHA, 2FA or payment step (AURA-118); Aura never solves CAPTCHAs.",
        "params": {
          "type": "object",
          "required": [
            "taskId",
            "reason"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "enum": [
                "continue",
                "cancel"
              ]
            }
          }
        }
      }
    },
    "notifications": {
      "task.text": {
        "type": "object",
        "required": [
          "taskId",
          "delta"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "delta": {
            "type": "string"
          }
        }
      },
      "task.step": {
        "type": "object",
        "required": [
          "taskId",
          "stepId",
          "tool",
          "label",
          "state"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "stepId": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "enum": [
              "ask",
              "run",
              "ok",
              "error",
              "denied"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "agent": {
            "type": "string"
          },
          "ms": {
            "type": "integer"
          },
          "verified": {
            "type": "boolean",
            "description": "Nur bei ändernden Werkzeugen mit Nachprüfung."
          }
        }
      },
      "task.done": {
        "type": "object",
        "required": [
          "taskId",
          "text",
          "cancelled",
          "verified",
          "steps",
          "ms",
          "usage"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "cancelled": {
            "type": "boolean"
          },
          "verified": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null: keine ändernde Aktion oder nicht prüfbar; false: mindestens eine Aktion laut Nachprüfung nicht wirksam."
          },
          "steps": {
            "type": "integer"
          },
          "ms": {
            "type": "integer"
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "integer"
              },
              "output": {
                "type": "integer"
              },
              "llm_calls": {
                "type": "integer"
              }
            }
          }
        }
      },
      "task.error": {
        "type": "object",
        "required": [
          "taskId",
          "message"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "model.status": {
        "type": "object",
        "required": [
          "state",
          "model"
        ],
        "properties": {
          "state": {
            "enum": [
              "loading",
              "ready",
              "error"
            ]
          },
          "model": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "task.plan": {
        "type": "object",
        "required": [
          "taskId",
          "items"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "status"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "in_progress",
                    "done",
                    "cancelled"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
