{
  "name": "aura-desktop",
  "productName": "Aura",
  "version": "0.7.0",
  "description": "Aura: hotkey assistant in Googlebook style for Windows and Linux, with Gemini or local models via Ollama",
  "main": "src/main.js",
  "author": {
    "name": "fischersase",
    "email": "121428169+fischersase@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor.js",
    "check": "for f in src/*.js src/agent/*.js src/renderer/*.js scripts/*.js; do node --check \"$f\" || exit 1; done",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.sebastian.aura",
    "productName": "Aura",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Aura-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "aura",
      "synopsis": "Aura: hotkey assistant with Live and dictation",
      "maintainer": "fischersase <121428169+fischersase@users.noreply.github.com>",
      "artifactName": "Aura-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "xdotool"
      ],
      "recommends": [
        "wtype",
        "speech-dispatcher"
      ]
    }
  },
  "homepage": "https://github.com/fischersase/windows-gemini"
}
