{
  "name": "aura-desktop",
  "productName": "Aura",
  "version": "0.15.0",
  "description": "Aura: desktop assistant for Windows and Linux with chat, voice, screen help and a careful agent; runs with Gemini or local models via Ollama",
  "main": "src/main.js",
  "author": {
    "name": "Sebastian Fischer",
    "url": "https://github.com/fischersase"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor.js",
    "check": "for f in src/*.js src/agent/*.js src/agent2/*.js src/renderer/*.js scripts/*.js test/*.js; do node --check \"$f\" || exit 1; done",
    "dist": "bash scripts/build-agent.sh && electron-builder --win nsis",
    "dist:win": "bash scripts/build-agent.sh && electron-builder --win nsis",
    "dist:linux": "umask 022 && bash scripts/build-agent.sh && electron-builder --linux AppImage deb",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" eslint.config.js",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "4.3.1",
    "@types/node": "22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "io.github.fischersase.aura",
    "productName": "Aura",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "Aura-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "build/agent-python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/browser-mcp/node_modules",
          "to": "browser-mcp/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "aura",
      "synopsis": "Aura: desktop assistant with chat, voice and a careful agent",
      "maintainer": "Sebastian Fischer <121428169+fischersase@users.noreply.github.com>",
      "artifactName": "Aura-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/agent-python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/browser-mcp/node_modules",
          "to": "browser-mcp/node_modules",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "gnome-extension",
          "to": "gnome-extension",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libc6",
        "libgtk-3-0t64 | libgtk-3-0",
        "libglib2.0-0t64 | libglib2.0-0",
        "libnss3",
        "libnspr4",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libcups2t64 | libcups2",
        "libdbus-1-3",
        "libcairo2",
        "libpango-1.0-0",
        "libgbm1",
        "libexpat1",
        "libudev1",
        "libasound2t64 | libasound2",
        "libx11-6",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxrandr2",
        "libxkbcommon0",
        "libxss1",
        "libxtst6",
        "libnotify4",
        "libuuid1",
        "libsecret-1-0",
        "xdg-utils"
      ],
      "recommends": [
        "bubblewrap",
        "xdotool",
        "wtype",
        "speech-dispatcher",
        "python3-gi",
        "gir1.2-atspi-2.0",
        "poppler-utils"
      ],
      "afterInstall": "packaging/linux/after-install.sh",
      "afterRemove": "packaging/linux/after-remove.sh",
      "fpm": [
        "--deb-suggests=google-chrome-stable",
        "packaging/linux/copyright=/usr/share/doc/aura-desktop/copyright",
        "packaging/linux/lintian-overrides=/usr/share/lintian/overrides/aura-desktop",
        "packaging/linux/aura-archive-keyring.asc=/usr/share/keyrings/aura-archive-keyring.asc"
      ],
      "packageCategory": "utils"
    },
    "nsis": {
      "include": "packaging/windows/installer.nsh",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.js"
  },
  "homepage": "https://github.com/fischersase/aura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fischersase/aura.git"
  },
  "bugs": {
    "url": "https://github.com/fischersase/aura/issues"
  },
  "engines": {
    "node": ">=22.4"
  }
}
